# === 凭据:绝不入库 ===
.env
.env.*
*.key
*.pem
secrets*
credentials*
*_token
.tokens/

# === 构建 / 运行日志(不入库) ===
/.logs/
*.log
/build/
/dist/
*.exe
*.dll
*.pdb
*.lib
*.obj
*.o
*.a
*.so
*.dylib
*.zip
*.7z
*.tar.gz

# === Chromium 源码树(fetch 脚本拉取,不入库)===
/chromium/src/
/chromium/build/
/chromium/depot_tools/
/chromium/out/
/chromium/*.tar.*
# rebase 中途失败可能留下的临时文件(trap 会清,但审核规则里兜一层)
/chromium/UPSTREAM.tmp
# gclient 自己的产物与中途状态,都不该入库
/chromium/.gclient
/chromium/.gclient_entries
/chromium/.gcs_entries
/chromium/_bad_scm/
/chromium/.cipd/
/chromium/.cipd_bin/

# === 语言生态 ===
node_modules/
__pycache__/
*.pyc
.venv/
venv/
/venv/
*.egg-info/

# === 探针产物 ===
/probe/out/
/probe/screenshots/
/probe/*.json
!/probe/config*.json
# ego target 运行时生成的脚本与实验脚本(可重放,不入库)
/probe/_ego_scripts/
/probe/_ego_exp/

# === 编辑器 / 系统 ===
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~
