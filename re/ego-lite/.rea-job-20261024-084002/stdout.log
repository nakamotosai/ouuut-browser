import os, re, collections, hashlib, math
root=r'C:\\Users\\sai\\AppData\\Local\\Citro Labs\\ego lite\\Application\\0.6.0.22'
def scan(fn):
    data=open(os.path.join(root,fn),'rb').read()
    pat=re.compile(rb'(?:\\.\\.\\\\){2}[A-Za-z0-9_.\\-\\\\/]+')
    paths=pat.findall(data)
    paths=[p.decode('latin1').replace('\\\\\\\\','\\\\') for p in paths]
    ego=[p for p in paths if p.lower().startswith('..\\\\..\\\\ego\\\\')]
    return data, paths, ego
out=[]
for fn in ['chrome.dll','chrome_elf.dll','ego-browser.exe']:
    data,paths,ego=scan(fn)
    out.append(f'=== {fn} size={len(data)} total_backpath_strings={len(paths)} ego_paths={len(ego)}')
    # unique ego source files
    uniq=sorted(set(ego))
    out.append(f'  unique ego paths={len(uniq)}')
    for p in uniq[:120]: out.append('    '+p)
    c=collections.Counter()
    for p in paths:
        parts=p.split('\\\\')
        # strip leading .. .. 
        comps=[x for x in parts if x not in ('..','')]
        if comps: c[comps[0]]+=1
    out.append('  top-level counts: '+', '.join(f'{k}={v}' for k,v in c.most_common(25)))
text='\\n'.join(out)
p=os.path.join(os.environ['TEMP'],'ego-q2-q4-module-stats.txt'); open(p,'w',encoding='utf-8').write(text)
