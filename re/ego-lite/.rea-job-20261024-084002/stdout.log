    d[\"machine\"]=hex(pe.FILE_HEADER.Machine); d[\"timestamp\"]=pe.FILE_HEADER.TimeDateStamp; d[\"characteristics\"]=hex(pe.FILE_HEADER.Characteristics); d[\"imagebase\"]=hex(pe.OPTIONAL_HEADER.ImageBase); d[\"entrypoint\"]=hex(pe.OPTIONAL_HEADER.AddressOfEntryPoint)
    d[\"sections\"]=[{\"name\":s.Name.rstrip(b'\\x00').decode('latin1'),\"va\":hex(s.VirtualAddress),\"vsize\":s.Misc_VirtualSize,\"raw_offset\":hex(s.PointerToRawData),\"raw_size\":s.SizeOfRawData,\"chars\":hex(s.Characteristics)} for s in pe.sections]
