import os,re,hashlib
root=r'C:\\Users\\sai\\AppData\\Local\\Citro Labs\\ego lite\\Application'
files={
 'chrome.dll':os.path.join(root,r'0.6.0.22\\chrome.dll'),
 'chrome_elf.dll':os.path.join(root,r'0.6.0.22\\chrome_elf.dll'),
 'ego-browser.exe':os.path.join(root,r'0.6.0.22\\ego-browser.exe'),
 'ego.exe':os.path.join(root,'ego.exe'),
}
out=['# License / entitlement / domain scan (static)','']
terms=['license','License','LICENSE','activation','Activation','activate','entitlement','Entitlement','subscription','Subscription','billing','Billing','checkout','Checkout','paywall','Paywall']
for name,p in files.items():
    data=open(p,'rb').read()
    out.append('='*30+f' {name} sha256={hashlib.sha256(data).hexdigest().upper()}')
    for t in terms:
        c=data.count(t.encode())
        if c: out.append(f'  {t} = {c}')
    hosts=sorted(set(m.group(1).decode('latin1') for m in re.finditer(rb'https?://([A-Za-z0-9.-]+)',data)))
    interesting=[h for h in hosts if ('citro' in h.lower() or 'ego' in h.lower())]
    out.append('  citro/ego hosts: '+', '.join(interesting))
# daemon
rp=r'C:\\Users\\sai\\AppData\\Local\\Citro Labs\\ego lite\\Application\\0.6.0.22\\local-ego-daemon\\runtime'
out.append('='*30+' daemon runtime/*.mjs')
allhosts=set(); termhits={}
for fn in os.listdir(rp):
    if not fn.endswith('.mjs'): continue
    p=os.path.join(rp,fn); s=open(p,'r',encoding='utf-8',errors='replace').read()
    for t in terms:
        c=s.count(t)
        if c: termhits[t]=termhits.get(t,0)+c
    for m in re.finditer(r'https?://([A-Za-z0-9.-]+)',s):
        allhosts.add(m.group(1))
out.append('  license-like term hits: '+str(termhits))
out.append('  citro/ego hosts: '+', '.join(sorted(h for h in allhosts if 'citro' in h.lower() or 'ego' in h.lower())))
# sentry dsn + langfuse
p=os.path.join(rp,'sentry-CDLeU9NO.mjs'); s=open(p,'r',encoding='utf-8',errors='replace').read()
out.append('='*30+' sentry-CDLeU9NO.mjs DSN context')
for m in re.finditer(r'https://[0-9a-f]+@[A-Za-z0-9._-]+/[0-9]+',s):
    out.append('  DSN: '+m.group(0))
for kw in ['EGO_SENTRY_DSN','EGO_SENTRY_ENABLED','EGO_SENTRY_ENVIRONMENT']:
    i=s.find(kw); out.append(f'  {kw} @{i}' if i>=0 else f'  {kw} not found')
p=os.path.join(rp,'langfuse-DrM1oXnY.mjs'); s=open(p,'r',encoding='utf-8',errors='replace').read()
out.append('='*30+' langfuse endpoint context')
for m in re.finditer(r'/api/public/[A-Za-z0-9/._-]+',s): out.append('  path: '+m.group(0))
for kw in ['EGO_LANGFUSE_BASE_URL','EGO_LANGFUSE_PUBLIC_KEY','EGO_LANGFUSE_SECRET_KEY']:
    out.append(f'  {kw}: {\"present\" if kw in s else \"absent\"}')
outpath=os.path.join(os.environ['TEMP'],'ego-license-domain-scan.txt')
open(outpath,'w',encoding='utf-8',newline='\\n').write('\\n'.join(out)+'\\n')
print('WROTE',outpath,os.path.getsize(outpath),hashlib.sha256(open(outpath,'rb').read()).hexdigest().upper())
print('\\n'.join(out))
