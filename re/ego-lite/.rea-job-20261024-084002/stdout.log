"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json, re, io
p = r'.rea-job-20261024-084002\\stdout.log'
seen = {}
with io.open(p, 'r', encoding='utf-8', errors='ignore') as f:
    for lineno, line in enumerate(f, 1):
        if '\"evidence_id\":\"ev_' not in line:
            continue
        start = line.find('{\"evidence_id\"')
        if start < 0:
            continue
        frag = line[start:]
        # find balanced JSON object
        depth = 0; end = None
        for i, ch in enumerate(frag):
            if ch == '{': depth += 1
            elif ch == '}':
                depth -= 1
                if depth == 0:
                    end = i+1; break
        if not end: continue
        try:
            obj = json.loads(frag[:end])
        except Exception as e:
            print('ERR', lineno, e); continue
        eid = obj.get('evidence_id')
        if eid in seen: continue
        seen[eid] = (lineno, obj.get('operation'), (obj.get('subject') or {}).get('name'), ((obj.get('subject') or {}).get('digest') or {}).get('sha256'), (obj.get('provider') or {}).get('name'))
for eid,(ln,op,name,dig,prov) in seen.items():
    print(f'{eid}\\tline={ln}\\top={op}\\tsubject={name}\\tsha256={dig}\\tprovider={prov}')
