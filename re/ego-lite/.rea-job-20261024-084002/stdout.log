        if 32 <= b < 127:
            if not cur: start=i
            cur.append(b)
        else:
            if len(cur)>=minlen: out.append((start, cur.decode('latin1')))
            cur=bytearray()
    if len(cur)>=minlen: out.append((start, cur.decode('latin1')))
    return out

