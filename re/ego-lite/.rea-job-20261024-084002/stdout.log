import os, hashlib, collections
root = r'C:\\Users\\sai\\AppData\\Local\\Citro Labs\\ego lite\\Application'
path = os.path.join(root, '0.6.0.22', 'chrome.dll')
data = open(path,'rb').read()
import pefile
pe = pefile.PE(path, fast_load=True)
secs=[]
for s in pe.sections:
    name=s.Name.rstrip(b'\\0').decode('latin1')
    secs.append((s.PointerToRawData, s.PointerToRawData+max(s.SizeOfRawData,s.Misc_VirtualSize), name))
def sec(off):
    for a,b,n in secs:
        if a <= off < b: return n
    return '?'
rows=[]
start=0
while True:
    i=data.find(b'fingerprint', start)
    if i<0: break
    ctx=data[max(0,i-60):i+11+60]
    ctx=''.join(chr(c) if 32<=c<127 else '.' for c in ctx)
    rows.append((i,sec(i),ctx)); start=i+1
print('total',len(rows))
bysec=collections.Counter(r[1] for r in rows)
print('sections',dict(bysec))
# classify by nearest preceding recognizable token
groups=collections.defaultdict(list)
for off,s,c in rows:
    low=c.lower()
    if 'xnn_' in low: key='xnn (XNNPACK)'
    elif 'android_' in low: key='android/perfetto proto'
    elif 'fingerprintproof' in low or 'web_transport' in low: key='QUIC cert'
    elif 'graphics' in low or 'gpu' in low: key='gpu'
    elif 'font' in low: key='font'
    elif 'ssl' in low or 'tls' in low or 'cert' in low: key='tls/cert'
    elif 'histogram' in low or 'uma' in low: key='metrics'
    else: key='other'
    groups[key].append((off,s,c))
out=[]
for k,v in sorted(groups.items(), key=lambda x:-len(x[1])):
    out.append(f'### {k}: {len(v)}')
    seen=set()
    for off,s,c in v[:30]:
        # take a window around word
        j=c.lower().find('fingerprint')
        snip=c[max(0,j-55):j+70]
        if snip in seen: continue
        seen.add(snip)
        out.append(f'  [{s}] @{off}: {snip}')
text='\\n'.join(out)
print(text[:15000])
p=os.path.join(os.environ['TEMP'],'ego-fingerprint-classify.txt')
open(p,'w',encoding='utf-8').write(text+'\\n')
print('ARTIFACT',p,os.path.getsize(p),hashlib.sha256((text+'\\n').encode()).hexdigest().upper())
