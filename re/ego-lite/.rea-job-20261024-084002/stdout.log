"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$env:PYTHONIOENCODING='"'utf-8'; @'
import os,re,hashlib
root=r'C:\\Users\\sai\\AppData\\Local\\Citro Labs\\ego lite\\Application'
files={
 'chrome.dll':os.path.join(root,r'0.6.0.22\\chrome.dll'),
 'chrome_elf.dll':os.path.join(root,r'0.6.0.22\\chrome_elf.dll'),
 'ego-browser.exe':os.path.join(root,r'0.6.0.22\\ego-browser.exe'),
 'ego.exe':os.path.join(root,'ego.exe'),
}
needles=[b'ego.mojom.',b'ConnectToBootstrapLoop',b'Failed to extract Mojo message pipe from invitation',b'EGO_BROWSER_CLI_RELAY_CHILD',b'__egoEvaluateScript',b'__egoEvaluateReplScript',b'__egoEvaluatePreloadScript',b'__egoCompleteReplEvaluation',b'__egoNodeOutputCapture',b'egoOnServerReady',b'require(\\'node:module\\').runMain(',b'sendCDPMessage',b'Runtime.enable']
out=[]
for name,p in files.items():
    data=open(p,'rb').read()
    out.append('='*30+f' {name} sha256={hashlib.sha256(data).hexdigest().upper()} size={len(data)}')
    if b'ego.mojom.' in data:
        names=sorted(set(m.group().decode('ascii') for m in re.finditer(rb'ego\\.mojom\\.[A-Za-z0-9_]+',data)))
        out.append(f'[ego.mojom.*] unique={len(names)}')
        for n in names: out.append('  '+n)
    for nd in needles:
        c=data.count(nd)
        if c:
            out.append(f'[{nd.decode(\"utf-8\",\"replace\")}] count={c}')
            # first 3 offsets and context
            start=0; shown=0
            while shown<3:
                i=data.find(nd,start)
                if i<0: break
                lo=max(0,i-120); hi=min(len(data),i+len(nd)+180)
                ctx=data[lo:hi].decode('latin1').replace('\\r',' ').replace('\\n',' ')
                out.append(f'  @{i}: {ctx}')
                start=i+len(nd); shown+=1
outpath=os.path.join(os.environ['TEMP'],'ego-mojo-evidence.txt')
open(outpath,'w',encoding='utf-8',newline='\\n').write('\\n'.join(out)+'\\n')
print('WROTE',outpath,os.path.getsize(outpath),hashlib.sha256(open(outpath,'rb').read()).hexdigest().upper())
print('\\n'.join(out[:120]))
