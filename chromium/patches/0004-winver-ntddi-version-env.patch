diff --git a/build/config/win/BUILD.gn b/build/config/win/BUILD.gn
index 1edf10346d..d191494e70 100644
--- a/build/config/win/BUILD.gn
+++ b/build/config/win/BUILD.gn
@@ -304,8 +304,19 @@ config("runtime_library") {
 # Windows is available at runtime. Targets using these libraries need to
 # manually override this config for their compiles.
 config("winver") {
+  # ouuut: 允许用环境变量指定 NTDDI_VERSION。
+  # 上游写死 `NTDDI_WIN11_BR`,但**某些 SDK 没有这个宏**(实测 10.0.26100 只定义到
+  # `NTDDI_WIN11_GE`)。未定义的标识符在 `#if` 里求值为 0,于是
+  # `minwinbase.h` 里 `#if (NTDDI_VERSION >= NTDDI_LONGHORN)` 的整段被跳过 →
+  # `FILE_INFO_BY_HANDLE_CLASS` 没被声明 → 编译报
+  #   error: unknown type name 'FILE_INFO_BY_HANDLE_CLASS'
+  # 不设该环境变量时行为与上游完全一致。
+  _ouuut_ntddi = getenv("OUUUT_NTDDI_VERSION")
+  if (_ouuut_ntddi == "") {
+    _ouuut_ntddi = "NTDDI_WIN11_BR"
+  }
   defines = [
-    "NTDDI_VERSION=NTDDI_WIN11_BR",
+    "NTDDI_VERSION=$_ouuut_ntddi",
 
     # We can't say `=_WIN32_WINNT_WIN10` here because some files do
     # `#if WINVER < 0x0600` without including windows.h before,
